# Backend Server Port
PORT=5000

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/blockchain_wallet

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Email Configuration (Brevo)
BREVO_API_KEY=your_brevo_api_key
BREVO_USER=your_brevo_smtp_user
BREVO_PASS=your_brevo_smtp_pass
BREVO_FROM_EMAIL=your_verified_sender@gmail.com
EMAIL_FROM_NAME="Utadmane Admin"

# SMTP Relay Configuration (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_pass
SMTP_FROM="Utadmane Admin" <your_verified_sender@gmail.com>

# Environment
NODE_ENV=development
